APP_ENV=development
APP_NAME=HAL 2.0
API_PREFIX=/api/v1

# One OpenAI key powers HAL conversation and transcription.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_CHAT_MAX_OUTPUT_TOKENS=1400
OPENAI_CHAT_TIMEOUT_SECONDS=60
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# HAL v8.4 no longer calls Anthropic.
MAX_AUDIO_UPLOAD_MB=20

ELEVENLABS_API_KEY=
# HAL primary male multilingual voice.
# Default in code is ElevenLabs Adam; set this to another male Voice ID to override.
HAL_MALE_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Existing single voice ID works as fallback:
ELEVENLABS_VOICE_ID=
# Optional language-specific overrides:
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_EL=

PROVIDER_REFRESH_HOURS=24

DATABASE_URL=
JWT_SECRET=
ADMIN_PASSWORD=

# Gmail API lead delivery
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_LEAD_RECIPIENT=

# Optional advanced document-level comparison app
POLICY_ANALYZER_URL=https://ashlar-policyanalyzer.up.railway.app/
